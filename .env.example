# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=8080

# Comma-separated list of allowed browser origins for the admin UI
CORS_ORIGIN=http://localhost:5173

# Failed logins allowed per IP per 15 minutes before the API answers 429
# LOGIN_RATE_LIMIT_MAX=5

# Single sample restaurant and currency
RESTAURANT_NAME=Sample Restaurant
CURRENCY=AED

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=food_order
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Set to true for hosted databases that require TLS
DB_SSL=false

# Tests (npm test) create and rebuild their own database; they never touch DB_NAME.
# The database user needs permission to create databases. Default: food_order_test
# TEST_DB_NAME=food_order_test

# Token signing. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required when NODE_ENV=production
JWT_LOGIN_SECRET=change-me-to-a-long-random-string
JWT_LOGIN_TOKEN_EXPIRY=2d

# Set to 1 only when running behind exactly one trusted reverse proxy
# TRUST_PROXY=1
