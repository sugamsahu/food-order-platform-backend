{
  "name": "food-order-platform-backend",
  "version": "1.0.0",
  "description": "Food order platform API: staff admin API and customer mobile API",
  "main": "index.js",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node ./dist/index.js",
    "start:dev": "babel-node ./index.js",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && babel index.js -d dist && babel src -d dist/src",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "node scripts/reset-db.js",
    "test:unit": "cross-env NODE_ENV=test jest --runInBand tests/unit"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "convict": "6.2.4",
    "cors": "2.8.5",
    "dotenv": "^17.2.3",
    "express": "5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "1.10.1",
    "pg": "8.16.3",
    "pg-hstore": "2.3.4",
    "sequelize": "6.37.7",
    "sequelize-cli": "6.6.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/cli": "7.28.3",
    "@babel/core": "7.28.4",
    "@babel/eslint-parser": "7.28.4",
    "@babel/node": "7.28.0",
    "@babel/preset-env": "7.28.3",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "standard": "17.1.2",
    "supertest": "^7.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "globalSetup": "<rootDir>/tests/globalSetup.js"
  },
  "standard": {
    "parser": "@babel/eslint-parser",
    "env": [
      "jest"
    ],
    "ignore": [
      "dist/",
      "src/db/migrations/",
      "src/db/seeders/"
    ]
  }
}
